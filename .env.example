# Copiar a .env para desarrollo local.

# --- Obligatoria ---
# Local con docker compose up -d db:
DATABASE_URL=postgres://acta:acta_local@localhost:5432/acta
#
# En Easypanel: la cadena interna del servicio Postgres, por ejemplo
# postgres://postgres:CLAVE@mvp_db:5432/postgres
#
# Con Supabase: copiar la cadena de "Connect" -> "Session pooler".
# NO usar "Direct connection": el pooler anda sobre IPv4 y soporta las
# transacciones que el encadenado de hashes necesita.
# postgresql://postgres.REF:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres
# Con Supabase hay que poner además DATABASE_SSL=true (ver más abajo).

# --- Recomendadas ---
# URL pública del sistema. Se usa para armar el link del QR de testigos y el pie
# del PDF. Sin esto, el QR apunta al host desde el que se abrió la página.
URL_PUBLICA=http://localhost:3000

# Carpeta del volumen persistente (fotos, audios, clave de firma).
# En Easypanel debe coincidir con el punto de montaje del volumen.
DIR_DATOS=./data

# --- Opcionales ---
# Autoridad de sellado de tiempo RFC 3161.
# Alternativas: http://timestamp.digicert.com  ·  https://freetsa.org/tsr
TSA_URL=https://freetsa.org/tsr

# Poner en true para saltear el sellado de tiempo (útil sin salida a internet).
TSA_DESACTIVADA=false

# Tamaño máximo por archivo subido, en bytes. Por defecto 20 MB.
TAMANO_MAXIMO_BYTES=20971520

# Si el Postgres exige TLS (no es el caso dentro de la red interna de Easypanel).
DATABASE_SSL=false

# Clave de firma en PEM. Si no se define, se genera sola y queda en el volumen.
# Al pasar a un certificador licenciado, este es el lugar donde se enchufa.
# CLAVE_FIRMA_PEM=

# ---------- Cuentas ----------

# Clave de un solo uso para crear el PRIMER usuario de la aseguradora contra el servicio ya
# desplegado, con POST /api/instalacion. Hace falta porque con output 'standalone' ni
# scripts/ ni tsx viajan a la imagen de producción. El endpoint se auto-deshabilita apenas
# existe una cuenta de aseguradora; conviene borrar la variable después.
CLAVE_INSTALACION=

# Cuántos días dura una sesión. Por omisión, 30.
DIAS_SESION=30

# SÓLO para probar sobre http sin TLS. En producción NO se define.
# Sin TLS el navegador descarta la cookie Secure en silencio: el proxy no la ve y manda a
# /entrar en un bucle, sin ningún error en pantalla ni en el log. Es el modo de falla más
# difícil de diagnosticar de todo el módulo de cuentas.
# COOKIE_INSEGURA=true

# ---------- Lectura automática de los documentos del tercero ----------

# ARRANCA APAGADA, y es deliberado. El proveedor de demostración devuelve nombres, DNI y
# patentes con formato argentino correcto que NO salen de la foto. Encendido por omisión,
# un despliegue que simplemente no define nada fabricaría prueba de identidad sobre una
# persona que ni siquiera es usuaria del sistema.

# Nombre del proveedor, tal como figura en el REGISTRO de lib/extraccion.ts. Es el único
# interruptor que hay que mover para enchufar uno real, y también para volver atrás.
# ANTES de poner uno extranjero hay que resolver la transferencia internacional del art. 12
# de la Ley 25.326: ver el comentario al principio de lib/extraccion.ts.
PROVEEDOR_EXTRACCION=

# Para probar el circuito con el proveedor de demostración. Hay que pedirlo por su nombre.
# EXTRACCION_SIMULADA=true

# Apaga el módulo entero, gane lo que gane lo de arriba. Es el interruptor que necesita una
# aseguradora que todavía no resolvió el consentimiento del tercero.
# EXTRACCION_DESACTIVADA=true

# Confianza mínima, entre 0 y 1, para que un campo llegue marcado «Verificado». Por debajo
# se marca «Revisar dato» y hay que escribirlo a mano. Por omisión, 0.85.
UMBRAL_EXTRACCION=0.85
